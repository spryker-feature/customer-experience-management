{
    "name": "spryker-feature/customer-experience-management",
    "type": "library",
    "description": "CustomerExperienceManagement module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/business-on-behalf": "^1.0.0",
        "spryker/company": "^1.11.0",
        "spryker/company-business-unit": "^2.22.0",
        "spryker/company-role": "^1.14.0",
        "spryker/company-unit-address": "^1.19.0",
        "spryker/company-unit-address-label": "^1.6.0",
        "spryker/company-user": "^2.24.0",
        "spryker/country": "^3.1.0 || ^4.0.0",
        "spryker/customer": "^7.85.0",
        "spryker/customer-note": "^1.3.0",
        "spryker/glossary": "^3.0.0",
        "spryker/kernel": "^3.30.0",
        "spryker/locale": "^3.0.0 || ^4.0.0",
        "spryker/permission": "^1.0.0",
        "spryker/symfony": "^3.0.0",
        "spryker/transfer": "^3.27.0",
        "spryker/user": "^3.33.0",
        "spryker/uuid-behavior": "^1.0.0"
    },
    "require-dev": {
        "spryker/api-platform": "*",
        "spryker/code-sniffer": "*",
        "spryker/container": "*",
        "spryker/testify": "*"
    },
    "suggest": {
        "spryker/api-platform": "Required to expose the customers and company-users Backend API resources; without it the resource schemas are never discovered."
    },
    "autoload": {
        "psr-4": {
            "SprykerFeature\\": "src/SprykerFeature/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerFeatureTest\\": "tests/SprykerFeatureTest/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
